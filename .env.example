# Переменные окружения сервиса Vector KB.
# Скопируйте в `.env` и при необходимости измените значения.

APP_TITLE=Vector KB
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8317
LOG_LEVEL=INFO

RAW_DIR=data/raw
OUT_DIR=data/out
DIRECTORY_DATA_DIR=app/services/directory_service/data
INDEX_PATH=data/index.json
LANDMARKS_PATH=app/services/parsing_service/landmarks.json

PARSE_PAUSE=1.5
REQUEST_TIMEOUT=30.0

# Реальный e-mail или адрес сайта (требование Nominatim). Без него запросы отклоняются.
GEOCODER_CONTACT=

# Ключи DaData (личный кабинет dadata.ru). Значения — только в локальном `.env`.
# DADATA_API_KEY нужен всегда (Подсказки и Cleaner).
# У Подсказок бесплатный лимит — 10 000 запросов в сутки.
DADATA_API_KEY=
# DADATA_SECRET_KEY нужен только при GEOCODER_PROVIDER=dadata_cleaner.
# У Cleaner бесплатно 100 запросов, дальше платно.
DADATA_SECRET_KEY=
# Провайдер: dadata (подсказки, по умолчанию), dadata_cleaner или nominatim.
GEOCODER_PROVIDER=dadata
